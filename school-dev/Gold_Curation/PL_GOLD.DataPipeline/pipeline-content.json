      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "SELECT COALESCE(MAX(FinishedAtUTC),\r\nCAST('1970-01-01T00:00:00' AS DATETIME2(3))) AS last_modified\r\nFROM LISE.IngestionLogs\r\nWHERE Layer = 'Gold' AND TargetObject = 'Multiple' AND Status = 'Succeeded';",
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "DataWarehouseTable",
            "typeProperties": {
              "schema": "LISE",
              "table": "IngestionLogs"
            },
