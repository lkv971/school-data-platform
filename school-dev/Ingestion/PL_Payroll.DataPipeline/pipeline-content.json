            {
              "name": "DQ_Check_PayrollDuplicates",
              "type": "Script",
              "dependsOn": [
                {
                  "activity": "UpsertPayroll",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "connectionSettings": {
                "name": "a098f517_3cea_4db8_98a0_2f4211f2bf1a",
                "properties": {
                  "annotations": [],
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "endpoint": "@pipeline().libraryVariables.VL_LISE_WH_Gold_SQL_Connection",
                    "artifactId": "@pipeline().libraryVariables.VL_LISE_WH_Gold_ID",
                    "workspaceId": "@pipeline().libraryVariables.VL_LISE_Workspace_ID"
                  },
                  "externalReferences": {
                    "connection": "@pipeline().libraryVariables.VL_LISE_Warehouse_Connection"
                  }
                }
              },
              "typeProperties": {
                "scripts": [
                  {
                    "type": "Query",
                    "text": {
                      "value": "DECLARE @pPayPeriod varchar(7) = '@{variables('varPeriod')}';\r\n\r\nDECLARE @PayDate date =\r\n    DATEFROMPARTS(CONVERT(int, LEFT(@pPayPeriod, 4)),\r\n                  CONVERT(int, RIGHT(@pPayPeriod, 2)),\r\n                  1);\r\n\r\nIF EXISTS (\r\n    SELECT 1\r\n    FROM LISE.Payroll\r\n    WHERE [Date] = @PayDate\r\n    GROUP BY PersonnelID, [Date]\r\n    HAVING COUNT(*) > 1\r\n)\r\nBEGIN\r\n    DECLARE @msg nvarchar(4000);\r\n\r\n    SELECT TOP 1\r\n        @msg = CONCAT(\r\n            'DQ FAIL: Duplicate payroll rows detected for PayDate=',\r\n            CONVERT(varchar(10), @PayDate, 120),\r\n            '. Example PersonnelID=',\r\n            CAST(PersonnelID AS varchar(20)),\r\n            ' has ',\r\n            CAST(COUNT(*) AS varchar(10)),\r\n            ' rows.'\r\n        )\r\n    FROM LISE.Payroll\r\n    WHERE [Date] = @PayDate\r\n    GROUP BY PersonnelID, [Date]\r\n    HAVING COUNT(*) > 1\r\n    ORDER BY COUNT(*) DESC;\r\n\r\n    THROW 51021, @msg, 1;\r\nEND;\r\n",
                      "type": "Expression"
                    }
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              }
            }
          ]
        }
      },
      {
        "name": "IfDayIs30",
